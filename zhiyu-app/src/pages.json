{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "织愈"
			}
		},
		{
			"path": "pages/home/index",
			"style": {
				"navigationBarTitleText": "织愈"
			}
		},
		{
			"path": "pages/emotion/chat",
			"style": {
				"navigationBarTitleText": "情绪倾听"
			}
		},
		{
			"path": "pages/craft/recommend",
			"style": {
				"navigationBarTitleText": "疗愈推荐"
			}
		},
		{
			"path": "pages/craft/session",
			"style": {
				"navigationBarTitleText": "创作引导"
			}
		},
		{
			"path": "pages/work/list",
			"style": {
				"navigationBarTitleText": "作品社区",
				"enablePullDownRefresh": true,
				"onReachBottomDistance": 50
			}
		},
		{
			"path": "pages/work/detail",
			"style": {
				"navigationBarTitleText": "作品详情",
				"onReachBottomDistance": 50
			}
		},
		{
			"path": "pages/work/publish",
			"style": {
				"navigationBarTitleText": "发布作品"
			}
		},
		{
			"path": "pages/group/list",
			"style": {
				"navigationBarTitleText": "互助小组"
			}
		},
		{
			"path": "pages/group/create",
			"style": {
				"navigationBarTitleText": "创建小组"
			}
		},
		{
			"path": "pages/profile/index",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"globalStyle": {
		"navigationBarBackgroundColor": "#F7F4EF",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "织愈",
		"backgroundColor": "#F7F4EF"
	},
	"tabBar": {
		"color": "#8A8A8A",
		"selectedColor": "#2D9B8F",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/home/index",
				"text": "首页",
				"iconPath": "static/tabbar/home-normal.png",
				"selectedIconPath": "static/tabbar/home-active.png"
			},
			{
				"pagePath": "pages/work/list",
				"text": "社区",
				"iconPath": "static/tabbar/community-normal.png",
				"selectedIconPath": "static/tabbar/community-active.png"
			},
			{
				"pagePath": "pages/group/list",
				"text": "小组",
				"iconPath": "static/tabbar/group-normal.png",
				"selectedIconPath": "static/tabbar/group-active.png"
			},
			{
				"pagePath": "pages/profile/index",
				"text": "我的",
				"iconPath": "static/tabbar/profile-normal.png",
				"selectedIconPath": "static/tabbar/profile-active.png"
			}
		]
	}
}
