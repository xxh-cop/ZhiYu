<view class="zy-tabbar">
	<view class="zy-tabbar-row">
		<view
			wx:for="{{items}}"
			wx:key="path"
			class="zy-tab-item {{active === item.path ? 'is-active' : ''}}"
			data-path="{{item.path}}"
			bindtap="onTap"
			aria-role="tab"
			aria-label="{{item.text}}"
		>
			<view class="zy-tab-mark"></view>
			<text class="zy-tab-text">{{item.text}}</text>
		</view>
	</view>
</view>
