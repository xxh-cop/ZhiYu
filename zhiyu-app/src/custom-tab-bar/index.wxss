/*
 * 自定义 tabBar 样式（原生 wxss，不走 rpx 变量继承：组件在页面根 view 之外，拿不到 --zy-* 变量）。
 * v7「一线」：白底 + 顶部发丝线 + 五个纯文字入口，取消缺口 SVG 与中央悬浮球。
 * 条体 104rpx；底部安全区由根节点底色填充。
 */
.zy-tabbar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 990;
	box-sizing: border-box;
	height: calc(104rpx + constant(safe-area-inset-bottom));
	height: calc(104rpx + env(safe-area-inset-bottom));
	padding-bottom: constant(safe-area-inset-bottom);
	padding-bottom: env(safe-area-inset-bottom);
	background-color: #ffffff;
	border-top: 1px solid #D3DED8;
}

.zy-tabbar-row {
	position: relative;
	display: flex;
	align-items: stretch;
	height: 104rpx;
}

.zy-tab-item {
	position: relative;
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 8rpx;
	height: 100%;
}

.zy-tab-mark {
	width: 26rpx;
	height: 2rpx;
	background-color: transparent;
	transition: background-color 250ms cubic-bezier(0.22, 1, 0.36, 1);
}

.zy-tab-text {
	font-size: 22rpx;
	line-height: 1.4;
	color: #6E7B75;
	letter-spacing: 1rpx;
}

.zy-tab-item.is-active .zy-tab-text {
	color: #111816;
	font-weight: 500;
}

.zy-tab-item.is-active .zy-tab-mark {
	background-color: #A64842;
}
