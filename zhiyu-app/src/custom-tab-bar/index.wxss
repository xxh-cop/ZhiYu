/*
 * 自定义 tabBar 样式（原生 wxss，不走 rpx 变量继承：组件在页面根 view 之外，拿不到 --zy-* 变量）。
 * v7「一线」+ P0 图标化（2026-11-18）：白底 + 顶部发丝线 + 线性图标/文字五入口；
 * 选中 = 窑青 + 朱砂短线；「我的」挂未读朱砂圆点。条体 112rpx；底部安全区由根节点底色填充。
 * 图标 data-URI 由 .ai-tmp/gen-tabbar-wxss.js 生成，与 src/components/ZyIcon.vue 同一套 path。
 */
.zy-tabbar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 990;
	box-sizing: border-box;
	height: calc(112rpx + constant(safe-area-inset-bottom));
	height: calc(112rpx + env(safe-area-inset-bottom));
	padding-bottom: constant(safe-area-inset-bottom);
	padding-bottom: env(safe-area-inset-bottom);
	background-color: #ffffff;
	border-top: 1px solid #D3DED8;
}

.zy-tabbar-row {
	position: relative;
	display: flex;
	align-items: stretch;
	height: 112rpx;
}

.zy-tab-item {
	position: relative;
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4rpx;
	height: 100%;
}

.zy-tab-mark {
	position: absolute;
	top: 6rpx;
	width: 26rpx;
	height: 3rpx;
	background-color: transparent;
	transition: background-color 250ms cubic-bezier(0.22, 1, 0.36, 1);
}

.zy-tab-iconwrap { position: relative; display: flex; }
.zy-tab-icon {
	width: 40rpx;
	height: 40rpx;
	background-size: contain;
	background-repeat: no-repeat;
	background-position: center;
}
.zy-tab-dot {
	position: absolute;
	top: -2rpx;
	right: -8rpx;
	width: 14rpx;
	height: 14rpx;
	border-radius: 50%;
	background-color: #C0392B;
	border: 2rpx solid #ffffff;
	box-sizing: border-box;
}

.zy-tab-text {
	font-size: 24rpx;
	line-height: 1.3;
	color: #586379;
	letter-spacing: 1rpx;
}

.zy-tab-item.is-active .zy-tab-text {
	color: #24478f;
	font-weight: 600;
}

.zy-tab-item.is-active .zy-tab-mark {
	background-color: transparent;
}
/* v8：选中项图标落在青绿浅底胶囊里；宣纸白底 */
