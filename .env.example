# ===== 织愈 本地开发环境变量 =====
# 复制此文件为 .env 并填入真实值
# .env 已被 gitignore，不会提交
#
# 重要：.env 里只放需要覆盖 application-dev.yml 默认值的变量。
#      不要放 JWT_SECRET / DB_PASSWORD 等——这些在 application-dev.yml 里已有合法默认值，
#      写进 .env 反而会因值不规范导致启动失败。
#
# 字段加密密钥（FIELD_ENCRYPT_SECRET，上线阻塞项）：
#      生产/演示环境必须设置独立的 base64（32 字节）密钥，未设置或命中仓库内置
#      开发/测试默认密钥时后端启动即失败（fail-fast）。
#      本地开发沿用 application-dev.yml 内置开发密钥时，必须显式设置
#      ZHIYU_CRYPTO_ALLOW_DEFAULT_SECRET=true（默认 false，不开不让用）。
ZHIYU_CRYPTO_ALLOW_DEFAULT_SECRET=true

# DeepSeek API（唯一需要手动填的）
DEEPSEEK_API_KEY=sk-your-real-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 豆包 Embedding API（火山引擎方舟）
DOUBAO_API_KEY=your-doubao-api-key-here

# AI 运营页成本估算费率（每百万 token；0 表示未配置，仅显示 token 用量）
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_COST_CURRENCY=CNY
# ---------- 语音 ----------
# gateway = 自建 JSON 网关；qianwen = 千问AI平台语音适配器
SPEECH_PROVIDER=qianwen

# 千问AI平台语音（ASR + TTS）
QIANWEN_SPEECH_ENABLED=true
QIANWEN_API_KEY=
QIANWEN_BASE_URL=https://maas.qianwenaiapi.com/api/v1
QIANWEN_ASR_MODEL=fun-asr-flash-2026-06-15
QIANWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QIANWEN_TTS_VOICE=longanhuan_v3.1
QIANWEN_ASR_SAMPLE_RATE=16000

# 自建 JSON 网关（SPEECH_PROVIDER=gateway 时使用；见 docs/speech-gateway.md）
ZHIYU_SPEECH_ENABLED=false
ZHIYU_SPEECH_ENDPOINT=
ZHIYU_SPEECH_API_KEY=
