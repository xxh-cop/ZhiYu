# ===== 织愈 环境变量模板 =====
# 复制为 .env 并按需填写。.env 不提交 Git。

# ---------- 服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/zhiyu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
JWT_EXPIRE_HOURS=12

# ---------- 加密（敏感字段应用层加密密钥，务必保管好，不要提交） ----------
FIELD_ENCRYPT_SECRET=change_me_aes_key_16_or_32_bytes

# ---------- 大模型（云端） ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_CHAT_MODEL=deepseek-chat

QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_API_KEY=sk-xxx
QWEN_CHAT_MODEL=qwen-plus

# ---------- 本地化 AI（Ollama，数据不出校园时启用） ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ---------- 语音（讯飞/阿里云，按需） ----------
ASR_PROVIDER=xunfei
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
TTS_PROVIDER=xunfei

# ---------- 向量库 ----------
VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- 对象存储 ----------
OSS_TYPE=local
LOCAL_STORAGE_DIR=./data/upload
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=zhiyu

# ---------- 危机干预联系方式（前端展示） ----------
PSYCH_CENTER_PHONE=0791-0000000
NATIONAL_HOTLINE=12356
