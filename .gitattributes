# 统一换行符策略：仓库内一律 LF，Windows 检出时也保持 LF
* text=auto eol=lf

# 明确源码与文档用 LF
*.java      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.properties text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.feature   text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.st        text eol=lf
*.txt       text eol=lf

# Windows 脚本保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件不做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.jar       binary
*.zip       binary
*.docx      binary
*.xlsx      binary