      "shadowPop": "0 16rpx 48rpx rgba(72,58,34,0.14)"
    }
  },
  "semantic": {
    "success": "#2E7D5B",
    "warning": "#9A6A12",
    "warningText": "#7A5C12",
    "care": "#A64842",
    "info": "#217E76"
  },
  "dark": {
    "bg": "#14201C",
    "surface": "#1C2B26",
    "text": "#E8EDE9",
    "textSecondary": "#A9BBB2",
    "primary": "#5BC4A8",
    "care": "#D4736A",
    "gold": "#D9A441"
  },
  "shape": {
